# Перечень переменных окружения (имена без значений) — ТЗ, раздел 9.3.
# Значения задаются только в ЛК Amvera («Переменные окружения»), в git не попадают.

# ── apps/bot ────────────────────────────────────────────────────────────────
NODE_ENV=
LOG_LEVEL=
BOT_TOKEN=
MONGO_URI=
GENERATION_PROVIDER=
BFL_API_KEY=
BFL_BASE_URL=
FAL_API_KEY=
BFL_MODEL=
VARIANTS_DEFAULT=
DAILY_LIMIT=
DAILY_BUDGET_USD=
GENERATION_TIMEOUT_MS=
GENERATION_CONCURRENCY=
MAX_QUEUE_SIZE=
MOCK_DELAY_MS=
RETENTION_DAYS=
INTERNAL_API_PORT=
INTERNAL_API_KEY=
DATA_DIR=
TZ=

# ── apps/admin ──────────────────────────────────────────────────────────────
# NODE_ENV, LOG_LEVEL, MONGO_URI — общие с ботом
BOT_INTERNAL_API_URL=
BOT_INTERNAL_API_KEY=
SESSION_SECRET=
ADMIN_LOGIN=
ADMIN_PASSWORD=
DEPLOY_LOGIN=
DEPLOY_PASSWORD=
DEPLOY_GIT_BASE=
DEPLOY_REPOS=
# master, который кнопка «Задеплоить» клонирует и раскладывает по проектам Amvera
DEPLOY_SOURCE_URL=https://github.com/dbn789/beauty-bot-service.git
PORT=
