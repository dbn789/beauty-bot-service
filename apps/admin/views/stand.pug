extends layout.pug

block content
  - const f = form || {}
  - const modelId = f.model || (meta && meta.currentModel) || 'flux-2-pro'
  - const variants = f.variants || (meta && meta.variants) || 3
  - const resolution = f.resolution || '2mp'
  - const keepPrompt = form ? Boolean(f.keepPrompt) : true
  - const safety = f.safetyTolerance != null && f.safetyTolerance !== '' ? f.safetyTolerance : 2
  - const outputFormat = f.outputFormat || 'jpeg'
  - const guidance = f.guidance || '5'
  - const steps = f.steps || '50'
  - const prompt = f.prompt != null ? f.prompt : (meta && meta.defaultPrompt) || ''

  h1 Тестовый стенд
  p.muted Ручной запрос в BFL, чтобы сравнить качество до того, как менять бота. Запуск списывает кредиты и попадает в журнал «Генерации» как «Стенд», вместе с расходом за день.

  if botError
    p.banner Бот недоступен (#{botError}). Форма появится, когда Internal API ответит.
  if error
    p.banner= error

  if result && result.images
    p.ok Готово за #{Math.round(result.elapsedMs / 1000)} с · оценка до $#{result.estimateUsd} · #{result.model}
    .stand-grid
      each image, index in result.images
        figure
          img(src=`data:${image.mime};base64,${image.base64}` alt=`Вариант ${index + 1}`)
          figcaption Вариант #{index + 1} · #{image.width}×#{image.height}
    if result.request
      dl.stand-echo
        dt Что ушло в BFL
        dd
          each pair in Object.entries(result.request)
            div
              strong #{pair[0]}:
              |  #{pair[1]}

  if meta
    form.notes-form(method="post" action="/stand" enctype="multipart/form-data" onsubmit="return confirm('Запрос спишет кредиты BFL. Продолжить?')")
      label Количество изображений
      input(type="number" name="variants" min="1" max="4" required value=variants)
      span.muted В боте сейчас всегда 3. Один и тот же seed даст одинаковые варианты — для сравнения моделей оставьте seed, для разных картинок очистите его.

      label Текст запроса
      textarea(name="prompt" rows="5" required)= prompt
      span.muted В поле уже боевой шаблон: менять только причёску и оставить лицо. Его можно переписать целиком.

      label Модель BFL
      select(name="model" id="stand-model")
        each model in meta.models
          option(
            value=model.id
            selected=(model.id === modelId)
            data-controls=(model.controls || []).join(',')
            data-price=model.priceUsd
          ) #{model.title} · от $#{model.priceUsd}/МП
      p.muted#stand-model-note

      label Размер выхода
      select(name="resolution" id="stand-resolution")
        each item in meta.resolutions
          option(value=item.id selected=(item.id === resolution) data-mp=item.megapixels)= item.title
      span.muted Бот режет выход примерно до 1.1 МП — на лице от этого пропадает деталь, и модель её дорисовывает. Исходник меньше выбранного предела не увеличивается.

      label Исходное фото
      input(type="file" name="image" accept="image/jpeg,image/png" required)
      span.muted JPEG или PNG, меньшая сторона от 512 пикселей, до 10 МБ.

      label Seed
      input(type="number" name="seed" min="0" max="2147483647" placeholder="пусто — случайный" value=f.seed || '')

      label Формат файла
      select(name="outputFormat")
        option(value="jpeg" selected=(outputFormat === 'jpeg')) jpeg
        option(value="png" selected=(outputFormat === 'png')) png
      span.muted PNG без сжатия jpeg. На сходство лица почти не влияет, удобно сравнивать вплотную.

      label.only-flex(data-control="guidance") guidance (только flex, 1.5–10)
      input.only-flex(data-control="guidance" type="number" name="guidance" min="1.5" max="10" step="0.1" value=guidance)
      span.only-flex.muted(data-control="guidance") Выше — текст «не менять лицо» держится жёстче, кожа может стать пластиковой. У API по умолчанию 5.

      label.only-flex(data-control="steps") steps (только flex, 1–50)
      input.only-flex(data-control="steps" type="number" name="steps" min="1" max="50" step="1" value=steps)
      span.only-flex.muted(data-control="steps") Больше шагов — больше деталей. У API по умолчанию 50, это потолок.

      label safety_tolerance (0–5)
      input(type="number" name="safetyTolerance" min="0" max="5" step="1" value=safety)
      span.muted Модерация, не сходство. 0 строже всего. 6 и 7 API может отклонить, поэтому их нет.

      label.checkline
        input(type="checkbox" name="keepPrompt" value="1" checked=keepPrompt)
        span Не давать модели переписывать текст
      span.keep-note.muted У pro и max BFL по умолчанию переписывает промпт (disable_pup). У flex это prompt_upsampling. Бот сейчас этот флаг не шлёт, стенд по умолчанию шлёт. У klein такого поля нет.

      p.muted#stand-cost
      button(type="submit") Сгенерировать

    script.
      (function () {
        var model = document.getElementById('stand-model');
        var resolution = document.getElementById('stand-resolution');
        var note = document.getElementById('stand-model-note');
        var cost = document.getElementById('stand-cost');
        var variants = document.querySelector('[name=variants]');
        var notes = !{JSON.stringify(Object.fromEntries(meta.models.map((item) => [item.id, item.note])))};
        var sync = function () {
          var option = model.options[model.selectedIndex];
          var controls = (option.getAttribute('data-controls') || '').split(',').filter(Boolean);
          document.querySelectorAll('.only-flex').forEach(function (el) {
            el.hidden = controls.indexOf(el.getAttribute('data-control')) === -1;
          });
          var keep = document.querySelector('[name=keepPrompt]');
          var keepOn = controls.indexOf('disablePup') !== -1 || controls.indexOf('promptUpsampling') !== -1;
          if (keep) keep.closest('label').hidden = !keepOn;
          var keepNote = document.querySelector('.keep-note');
          if (keepNote) keepNote.hidden = !keepOn;
          note.textContent = notes[option.value] || '';
          var price = Number(option.getAttribute('data-price') || 0);
          var mp = Number(resolution.options[resolution.selectedIndex].getAttribute('data-mp') || 1);
          var count = Math.max(1, Number(variants.value) || 1);
          cost.textContent = 'Оценка до $' + (price * mp * count).toFixed(3) + ' — цена BFL растёт с мегапикселями выхода.';
        };
        model.addEventListener('change', sync);
        resolution.addEventListener('change', sync);
        variants.addEventListener('input', sync);
        sync();
      })();
