extends layout

block content
  h1 Настройки
  .subtabs
    each s in sections
      a(href=`/settings/${s.key}` class=(section === s.key ? 'active' : ''))= s.title

  .settings-card
    if saved
      p.ok ✅ Сохранено
    h2= current.title
    p.muted= current.hint

    h3 Запланировано на следующих шагах
    ul.planned
      each item in current.planned
        li= item

    if section === 'deploy' && deploy
      hr
      if deploy.flash === 'ok'
        p.ok ✅ Деплой запущен успешно: push прошёл в оба репозитория, платформа пересобирает сервисы (2–3 минуты).
      if deploy.flash === 'busy'
        p.banner Деплой уже выполняется — дождитесь завершения.
      if deploy.flash === 'error'
        p.banner Ошибка деплоя — смотрите последнюю попытку ниже или логи сервиса.
      if !deploy.configured
        p.banner Кнопка не настроена: задайте DEPLOY_LOGIN, DEPLOY_PASSWORD, DEPLOY_GIT_BASE, DEPLOY_REPOS в переменных окружения beauty-admin.
      else
        form.notes-form(method="post" action="/settings/deploy/run" onsubmit="return confirm('Пересобрать и перезапустить оба сервиса на Amvera?')")
          button.deploy-btn(type="submit" disabled=deploy.running)= deploy.running ? 'Деплой выполняется…' : '🚀 Задеплоить на Amvera'
          span.muted Пуш в beauty-bot и beauty-admin → пересборка и перезапуск (~2–3 минуты). Настройки из БД бот подхватит после рестарта.
        if deploy.lastResult
          p.muted Последний запуск: #{deploy.lastResult.at} · #{deploy.lastResult.by} ·
            = deploy.lastResult.ok ? ' успех' : ' ошибка'
            if !deploy.lastResult.ok
              |  — #{deploy.lastResult.detail}

    form.notes-form(method="post" action=`/settings/${section}`)
      label Заметка раздела (работает уже сейчас)
      textarea(name="notes" rows="3" placeholder="Например: согласовать тексты с администратором салона")= notes
      button(type="submit") Сохранить заметку
