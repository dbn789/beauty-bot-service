extends layout

block content
  h1 Генерации
  if botError
    p.banner Бот недоступен (#{botError}) — журнал не получен.
  else if data
    form.filters(method="get" action="/generations")
      label Статус
      select(name="status")
        option(value="" selected=!filters.status) все
        each s in ['done', 'error', 'queued', 'processing', 'budget_stopped']
          option(value=s selected=filters.status === s)= s
      label С днём
      input(type="date" name="from" value=filters.from placeholder="YYYY-MM-DD")
      label по
      input(type="date" name="to" value=filters.to placeholder="YYYY-MM-DD")
      button(type="submit") Применить

    p.muted Всего: #{data.total}

    table.table
      thead
        tr
          th Дата
          th Пользователь
          th Запрос
          th Статус
          th Вариантов
          th Длительность
          th Превью
          th Ошибка
      tbody
        each item in data.items
          tr
            td= new Date(item.createdAt).toLocaleString('ru-RU')
            td
              if item.user
                = item.user.firstName || item.user.username || ''
                if item.user.tgId
                  span.muted= ' ' + item.user.tgId
              else
                span.muted —
            td
              - const promptText = (item.finalPrompt && item.finalPrompt !== '—') ? item.finalPrompt : (item.userText || '')
              if item.source === 'preset'
                = presetTitles[item.presetCode] || item.presetCode
              else if item.source === 'stand'
                span Стенд · #{item.model || 'bfl'}
              else
                span Свой текст
              if promptText || item.bflRequest
                button.icon-btn(type="button" title="Промпт и параметры запроса" aria-label="Промпт и параметры запроса" data-open-prompt data-prompt=promptText data-request=(item.bflRequest ? JSON.stringify(item.bflRequest) : ''))
                  svg(viewBox="0 0 24 24" width="16" height="16" aria-hidden="true")
                    path(fill="none" stroke="currentColor" stroke-width="2" d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z")
                    circle(cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2")
            td
              span.badge(class=item.status)= item.status
            td= item.variantsCount
            td= item.durationMs ? (item.durationMs / 1000).toFixed(1) + ' с' : '—'
            td.thumbs
              if item.deletedAt
                span.muted удалено
              else
                - const vs = Array.from({ length: item.variantsCount }, (_x, i) => i + 1)
                a(href=`/preview/${item.id}?ref=kind%3Dsource` target="_blank")
                  img.thumb(src=`/preview/${item.id}?ref=kind%3Dsource` alt="исходник" onerror="this.style.visibility='hidden'")
                each v in vs
                  a(href=`/preview/${item.id}?ref=v%3D${v}` target="_blank")
                    img.thumb(src=`/preview/${item.id}?ref=v%3D${v}` alt="вариант " + v onerror="this.style.visibility='hidden'")
            td.err= item.error ? (item.error.code + ': ' + (item.error.message || '').slice(0, 80)) : ''

    .pagination
      if page > 1
        a(href=`/generations?${queryString(Object.assign({}, filters, { page: page - 1 }))}`) ‹ назад
      span стр. #{data.page} из #{data.pages}
      if page < data.pages
        a(href=`/generations?${queryString(Object.assign({}, filters, { page: page + 1 }))}`) вперед ›

    dialog#prompt-modal.prompt-modal
      form(method="dialog")
        h2 Запрос к BFL
        pre#prompt-text
        dl#prompt-params
        button(type="submit") Закрыть

    script.
      (function () {
        var dialog = document.getElementById('prompt-modal');
        if (!dialog) return;
        var labels = {
          model: 'Модель',
          resolution: 'Разрешение',
          variants: 'Число картинок',
          width: 'Ширина',
          height: 'Высота',
          output_format: 'Формат',
          safety_tolerance: 'safety_tolerance',
          seed: 'Seed',
          disable_pup: 'Не переписывать промпт',
          prompt_upsampling: 'Переписывание промпта',
          guidance: 'Guidance',
          steps: 'Steps'
        };
        var order = Object.keys(labels);
        function show(value) {
          if (value === true) return 'да';
          if (value === false) return 'нет';
          return String(value);
        }
        document.querySelectorAll('[data-open-prompt]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            document.getElementById('prompt-text').textContent = btn.getAttribute('data-prompt') || '—';
            var data = {};
            try { data = JSON.parse(btn.getAttribute('data-request') || '{}'); } catch (e) { data = {}; }
            var keys = order.filter(function (key) { return data[key] != null && data[key] !== ''; });
            Object.keys(data).forEach(function (key) {
              if (key !== 'prompt' && keys.indexOf(key) === -1 && data[key] != null && data[key] !== '') keys.push(key);
            });
            var dl = document.getElementById('prompt-params');
            dl.textContent = '';
            keys.forEach(function (key) {
              var dt = document.createElement('dt');
              dt.textContent = labels[key] || key;
              var dd = document.createElement('dd');
              dd.textContent = show(data[key]);
              dl.appendChild(dt);
              dl.appendChild(dd);
            });
            dialog.showModal();
          });
        });
      }());
