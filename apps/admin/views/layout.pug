doctype html
html(lang="ru")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} · Beauty Admin` : 'Beauty Admin'
    link(rel="stylesheet" href="/css/style.css")
  body
    nav.topnav
      .brand 💇‍♀️ Beauty Admin
      .links
        a(href="/dashboard") Дашборд
        a(href="/generations") Генерации
        a(href="/users") Пользователи
        a(href="/settings") Настройки
        a(href="/about") О сервисе
      .whoami
        span= adminLogin || ''
        a.logout(href="/logout") Выйти
    main.content
      block content
